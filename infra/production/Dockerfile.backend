FROM python:3.12-slim
RUN pip install --no-cache-dir uv==0.8.22
WORKDIR /workspace/services/trackflow-api
COPY services/trackflow-api/pyproject.toml services/trackflow-api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY services/trackflow-api/ ./
COPY packages/ /workspace/packages/
COPY data/process/ /workspace/data/process/
RUN useradd --uid 10001 --create-home trackflow \
    && mkdir -p database \
    && chown -R trackflow:trackflow /workspace
ENV PATH="/workspace/services/trackflow-api/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER trackflow
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
